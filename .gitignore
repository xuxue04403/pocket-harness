# 忽略构建产物与本地工具链

# Flutter / Dart
app/.dart_tool/
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/android/.gradle/
app/android/local.properties
app/windows/flutter/ephemeral/
packages/dsh_link/.dart_tool/
packages/dsh_link/build/
**/*.g.dart.tmp

# Node
node_modules/
relay/node_modules/
probe/node_modules/

# 鸿蒙探针的构建产物与本地 SDK 指针（图标是构建输入，保留入库）
tools/ohos-probe/.hvigor/
tools/ohos-probe/entry/build/
tools/ohos-probe/local.properties

# 本地工具链（体积大、可重建，不入库）
toolchain/

# 参考仓库（仅本地阅读，且其中 dsh-go 是 AGPL，绝不入库）
ref/

# 探针产生的临时数据：含真实会话快照与配对票据
probe/samples/
probe/_live-ticket.txt
probe/_probe-identity.txt
probe/_host.err
probe/_host.out
probe/_shot*.png

# 防止私钥/凭据误入库
*.pem
*.key
.credentials.yaml

# 编辑器与 agent 工具产出的本地状态
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
.memsearch/
.probe

# 配对票据含 secret，绝不入库
probe/_live-ticket*.txt
probe/_log-ticket*.txt
probe/_relay-ticket*.txt
probe/_ticket.txt
probe/_t.txt
# 二维码就是票据的另一种画法，同样含 secret
probe/_pairing*.png
probe/_pairing*.svg
# 中继共享令牌：本机部署时生成，和票据同级敏感
relay/.relay-token
# VPS 登录口令与私钥探针留下的东西
probe/_vps_key.txt

# 探针日志会captured配对码，不入库
probe/_*.out
probe/_*.err
probe/_ui*.xml
# uiautomator dump 的快照随手起名，一律不入库
probe/_*.xml
probe/_msg*.txt
probe/_apkcheck/

# TypeScript protocol core build output
packages/dsh_arkts/node_modules/
packages/dsh_arkts/build/
probe/_fixture.json
probe/_tscheck/

# 协议核心在鸿蒙工程里是拷贝来的，唯一来源是 packages/dsh_arkts/src（build.ps1 自动同步）
tools/ohos-probe/entry/src/main/ets/core/
tools/ohos-probe/*.ts
!tools/ohos-probe/hvigorfile.ts

# 发布签名：私钥与口令都不入库（见 app/android/key.properties.example）
app/android/key.properties
*.jks
*.keystore
app/android/build/
app/android/app/*.jks
app/android/*.jks

# 本机跑 dsh 的探针产物：rootfs 与 proot 二进制都是几 MB 的下载物，不入库
probe/proot/
probe/_dshurl.txt
probe/_parse51*.ps1
tools/proot-dsh/cache/
# proot 是 GPLv2 二进制，不入库：由 tools/proot-fetch.ps1 从 Alpine 现取
app/android/app/src/main/jniLibs/
probe/bin/
probe/termux/
probe/proot/apk/
probe/_hashes.txt
probe/_p5.sh
probe/_proot*.sh
probe/_tar_check.sh
probe/_tp.sh
# 发行产物：由 flutter build apk --release --split-per-abi 生成，随 release 附件发布，不进仓库
dist/
# 本地发布凭据：任何情况下都不入库
probe/_gh_token.txt
# 发版时临时装的东西（isomorphic-git、npm 缓存、一次性脚本）：几十 MB，且随时可重装
probe/_publisher/
probe/_npmcache/
probe/_*.mjs
# 一次性探针：Python 脚本、抓下来的文档、生成的密钥、截图解码结果，都不入库
probe/_*.py
probe/_docs/
probe/_keys/
probe/_qr_tables.txt
# 读 asar 内部实现时写的一次性探针（要 ELECTRON_RUN_AS_NODE 才跑得起来），不是交付物
probe/_*.cjs
# 提交信息草稿：heredoc 在 pwsh 里不可用，只能先落文件再 -F
probe/_commit_msg.txt
probe/_ts_files.txt
probe/_vps_*
probe/_ph_deploy_key*
probe/_mkkkey.py
# 手工验证本机 dsh 时的临时脚本与截图（设备侧验证用，不入库）
probe/_*.sh
probe/_u.xml
probe/_web*.png
probe/_debprobe/
probe/proot/termux/

# 模拟器验证时抓的屏幕与 UI 树（本机设备验证用，不入库）
probe/_emu*.png
probe/_c*.png
probe/_crop*.png
probe/_ui*.xml
probe/_prefs-*.xml
probe/_emu-prefs/
probe/_emu-ticket.txt
probe/_parent_check.mjs
probe/_tmp/
probe/_nginx_current.txt
probe/_*.dart
probe/_*.pack
probe/_*.txt
probe/_commits*
probe/_obj*
probe/_revs*
probe/_to_send*
