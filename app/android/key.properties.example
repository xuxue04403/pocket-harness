# 发布签名配置示例。复制成 app/android/key.properties 再填自己的值。
#
# 这两个文件（key.properties 与 keystore）都在 .gitignore 里：
# 开源仓库里不该有能签出「看起来像官方包」的私钥。没有 key.properties 时
# release 构建回落到 debug 签名，只为让 `flutter run --release` 能跑，不能分发。
#
# 生成自己的 keystore：
#   keytool -genkeypair -v -keystore pocket-harness.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias pocket-harness
#
# storeFile 相对 app/android/ 目录。
storeFile=pocket-harness.jks
storePassword=change-me
keyAlias=pocket-harness
keyPassword=change-me
